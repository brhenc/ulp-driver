{
  "default": [
    {
      "type": "reject"
    }
  ],
  "transports": {
    "livepatch": {
      "/usr/local/sbin/haproxy": [
        {
          "type": "sigstoreSigned",
          "keyPath": "/etc/ulp/keys/haproxy-cosign.pub"
        }
      ],
      "/usr/sbin/mariadbd": [
        {
          "type": "signedBy",
          "keyType": "GPGKeys",
          "keyPath": "/etc/ulp/keys/mariadb-team.gpg"
        }
      ],
      "/usr/lib/postgresql/17/bin/postgres": [
        {
          "type": "sigstoreSigned",
          "keyPath": "/etc/ulp/keys/postgres-cosign.pub"
        }
      ]
    }
  }
}
